{
  "name": "retroachievements-obs-tracker-studio",
  "version": "1.0.2",
  "description": "Desktop settings application and local OBS Browser Source server for RetroAchievements.",
  "main": "main.js",
  "author": "RetroAchievements OBS Tracker Studio contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.raobs.trackerstudio",
    "productName": "RetroAchievements OBS Tracker Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tracker",
        "to": "tracker",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
  "target": [
    {
      "target": "nsis",
      "arch": ["x64"]
    }
  ],
  "artifactName": "RetroAchievements-OBS-Tracker-Studio-Setup-${version}.${ext}"
},
"publish": null,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RetroAchievements OBS Tracker Studio",
      "deleteAppDataOnUninstall": false
    }
  }
}