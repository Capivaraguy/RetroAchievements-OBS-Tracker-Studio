{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RetroAchievements OBS Tracker Studio",
  "version": "1.0.3",
  "identifier": "com.raobs.trackerstudio",
  "build": { "frontendDist": "../frontend" },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}